+}
+
+/* ---------------- main ---------------- */
+const found = collect(ROOT);
+if (WRITE) {
+  const entries = withIndex(found).map((v) => ({
+    file: v.file,
+    rule: v.rule,
+    snippet: v.snippet,
+    index: v.index,
